# Application
NODE_ENV=development
PORT=3003

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/payment_service?schema=public
DATABASE_SSL=false

# Redis
REDIS_URL=redis://redis:6379
REDIS_TTL=3600

# PromptPay Configuration
DEFAULT_PROMPTPAY_PHONE=0891234567  # Fallback phone number if driver's phone not available

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE_PREFIX=payment_service

# JWT 
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=3600

# ELK Stack
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Logging
LOG_LEVEL=debug

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGIN=*

# QR Code API
QR_CODE_API_URL=https://api.qrserver.com/v1/create-qr-code/

# Service Connection URLs
USER_DRIVER_SERVICE_URL=http://localhost:3001
VEHICLE_MATCHING_SERVICE_URL=http://localhost:3002

# API Keys
USER_DRIVER_API_KEY=your-api-key-here
VEHICLE_MATCHING_API_KEY=your-api-key-here