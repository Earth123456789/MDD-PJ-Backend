generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  QR_CODE
  CREDIT_CARD
  BANK_TRANSFER
  WALLET
}

model Payment {
  id             String        @id @default(uuid())
  order_id       String
  amount         Float
  currency       String        @default("THB")
  payment_method PaymentMethod @default(QR_CODE)
  status         PaymentStatus @default(PENDING)
  qr_code_url    String?
  transaction_id String?       @unique
  driver_id      String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  // Relations
  paymentLogs    PaymentLog[]
}

model PaymentTransaction {
  id                String    @id @default(uuid())
  amount            Float
  currency          String    @default("THB")
  description       String?
  transaction_type  String    // DEPOSIT, WITHDRAWAL, TRANSFER
  status            String    // PENDING, COMPLETED, FAILED
  external_ref_id   String?
  driver_id         String
  promptpay_number  String?   // เก็บเบอร์โทร PromptPay แทน
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
}

model PaymentLog {
  id          String    @id @default(uuid())
  payment_id  String
  status      String
  message     String?
  metadata    Json?
  created_at  DateTime  @default(now())

  // Relations
  payment     Payment   @relation(fields: [payment_id], references: [id])
}