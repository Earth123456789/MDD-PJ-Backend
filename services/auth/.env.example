# Application
NODE_ENV=development
PORT=3003

# Database
DATABASE_URL=postgresql://auth_user:auth_pass@auth-postgres:5432/auth_db?schema=public
DATABASE_SSL=false

# Redis
REDIS_URL=redis://redis:6379
REDIS_TTL=3600

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE_PREFIX=payment_service

# JWT 
JWT_SECRET=01de0298143403dbf30efef246f157dbbd24ed3ce3fe1f8c0e65b8a56c84d51de018a5843d42c2d5cdf8c7d027826f86c986eaa74fc80381d4f53f11b8be4a0c
JWT_EXPIRATION=24h

# ELK Stack
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Logging
LOG_LEVEL=debug

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGIN=*

# PromptPay Configuration
DEFAULT_PROMPTPAY_PHONE=0891234567  # Fallback phone number if driver's phone not available

# QR Code API
QR_CODE_API_URL=https://api.qrserver.com/v1/create-qr-code/

# Service Connection URLs
USER_DRIVER_SERVICE_URL=http://user-driver-service:3001
VEHICLE_MATCHING_SERVICE_URL=http://payment-service:3002

# API Keys
USER_DRIVER_API_KEY=your-api-key-here
VEHICLE_MATCHING_API_KEY=your-api-key-here