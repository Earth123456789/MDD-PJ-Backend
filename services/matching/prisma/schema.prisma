// matching/prisma/schema.prisma

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  PENDING
  MATCHING
  MATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  MAINTENANCE
  INACTIVE
}

enum VehicleType {
  CAR
  VAN
  TRUCK
  MOTORCYCLE
}

model Order {
  id String @id @default(uuid())

  user_id           String
  pickup_location   Json
  dropoff_location  Json
  package_weight_kg Float
  package_volume_m3 Float
  package_length_m  Float
  package_width_m   Float
  package_height_m  Float
  price             Float
  status            OrderStatus @default(PENDING)
  vehicle_matched   String?
  vehicle_id        String
  vehicle           Vehicle     @relation(fields: [vehicle_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  matchingScores   MatchingScore[]
  matchingAttempts MatchingAttempt[]
}

model Vehicle {
  id        String @id @default(uuid())
  driver_id String

  vehicle_type  VehicleType
  max_weight_kg Float
  max_volume_m3 Float
  length_m      Float
  width_m       Float
  height_m      Float
  status        VehicleStatus @default(AVAILABLE)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  // Relations
  orders           Order[]
  matchingScores   MatchingScore[]
  matchingAttempts MatchingAttempt[]
}

model MatchingScore {
  id              String   @id @default(uuid())
  order_id        String
  vehicle_id      String
  weight_score    Float
  volume_score    Float
  dimension_score Float
  total_score     Float
  created_at      DateTime @default(now())

  // Relations
  order   Order   @relation(fields: [order_id], references: [id])
  vehicle Vehicle @relation(fields: [vehicle_id], references: [id])
}

model MatchingAttempt {
  id             String   @id @default(uuid())
  order_id       String
  vehicle_id     String
  algorithm_used String
  score          Float
  status         String
  created_at     DateTime @default(now())

  // Relations
  order   Order   @relation(fields: [order_id], references: [id])
  vehicle Vehicle @relation(fields: [vehicle_id], references: [id])
}