_# Environment variables
NODE_ENV=development
PORT=5002

# Database
DATABASE_URL=

# JWT Secret
JWT_SECRET=your-shared-secret-key

# RabbitMQ
RABBIT_MQ_URL=amqp://rabbitmq:5672
ENABLE_RABBITMQ=true

# Logging
LOG_LEVEL=info

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Delivery System <noreply@yourdomain.com>