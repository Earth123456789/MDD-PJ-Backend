# Application
APP_NAME=tracking-service
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tracking?retryWrites=true&w=majority
MONGODB_DB=tracking

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE_PREFIX=tracking_service

# Security
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Services
USER_DRIVER_SERVICE_URL=http://user-driver-service:3001
MATCHING_SERVICE_URL=http://matching-service:3002
PAYMENT_SERVICE_URL=http://payment-service:3003

# Logging
LOG_LEVEL=debug

# Redis (optional, for caching/rate limiting)
REDIS_URL=redis://redis:6379

# WebSocket
WS_HEARTBEAT_INTERVAL=30  # seconds